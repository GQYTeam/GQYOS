#!/usr/bin/env bash
# GQYOS 文档查看器
set -euo pipefail

DOCS_DIR="/opt/gqyos/docs"

printf '\n'
printf '  GQYOS 安装文档\n'
printf '\n'

if [[ ! -d "$DOCS_DIR" ]]; then
  echo "文档目录不存在: $DOCS_DIR"
  exit 1
fi

echo "可用文档:"
echo ""
for f in "$DOCS_DIR"/*.md; do
  [[ -f "$f" ]] || continue
  name="$(basename "$f" .md)"
  echo "  - $name"
done

echo ""
read -rp "输入文档名称查看 (或按 Enter 退出): " choice
[[ -z "$choice" ]] && exit 0

doc="$DOCS_DIR/${choice}.md"
if [[ -f "$doc" ]]; then
  if command -v bat &>/dev/null; then
    bat "$doc"
  else
    less "$doc"
  fi
else
  echo "文档不存在: $choice"
fi
